    <string name="field_help_content_desc">Help for %1$s</string>
    <string name="help_app_name_desc">The display name of the app as users know it (e.g. \"Signal\", \"Firefox\", \"VLC\").</string>
    <string name="help_app_name_tip">Use the official name from the app\'s website or store listing.</string>
    <string name="help_app_name_title">App Name</string>
    <string name="help_description_desc">A brief summary of what the app does. Keep it to 1-3 sentences.</string>
    <string name="help_description_title">Description</string>
    <string name="help_fdroid_id_desc">The package name as listed on F-Droid. Usually the same as the package name, but some apps use a different ID for F-Droid builds.</string>
    <string name="help_fdroid_id_tip">Find it at f-droid.org — the ID is in the URL: f-droid.org/packages/&lt;fdroid.id&gt;/</string>
    <string name="help_fdroid_id_title">F-Droid ID</string>
    <string name="help_license_desc">The open source license the app is released under (e.g. GPL-3.0-only, GPL-3.0-or-later, MIT, Apache-2.0). This is required for FOSS submissions.</string>
    <string name="help_license_tip">Check the LICENSE or COPYING file in the app\'s source code repository, or look at the F-Droid listing.</string>
    <string name="help_license_title">License</string>
    <string name="help_package_name_desc">The unique technical identifier for the app (e.g. \"org.mozilla.firefox\"). This is NOT the display name.</string>
    <string name="help_package_name_tip">Find it on F-Droid (listed on the app page), or on the Play Store URL: play.google.com/store/apps/details?id=&lt;package.name&gt;. On your device: Settings → Apps → [App] → App info.</string>
    <string name="help_package_name_title">Package Name</string>
    <string name="help_repo_url_desc">The link to the app\'s public source code repository. This is required to verify the app is truly open source.</string>
    <string name="help_repo_url_tip">Look for it on the app\'s website, F-Droid listing, or search \"&lt;app name&gt; source code\" on GitHub/GitLab/Codeberg.</string>
    <string name="help_repo_url_title">Repository URL</string>
    <string name="help_search_alternatives_desc">Search for existing FOSS alternatives in our database to link to this proprietary app.</string>
    <string name="help_search_alternatives_title">Search Alternatives</string>
    <string name="help_target_apps_desc">The proprietary apps that this FOSS app can replace. For example, Signal replaces WhatsApp/Telegram.</string>
    <string name="help_target_apps_tip">Select from the list of known proprietary apps. If the target isn\'t listed, you can suggest it as a new proprietary target first.</string>
    <string name="help_target_apps_title">Target Proprietary Apps</string>
